CODE_ROOT = Path(__file__).resolve().parent.parent
KOK = Path(os.environ.get("YUVA_DIR") or (Path.home() / "yuva"))
KILIT = KOK / ".kilit"
BUS = KOK / "mesaj.jsonl"
STATE = KOK / "durum.json"
GOREV = KOK / "gorevler.json"
EKRAN = KOK / "ekran"
CALISAN = Path(__file__).resolve()

RENK = {"claude": "38;5;208", "codex": "36", "opencode": "35", "diger": "32"}
ROL_AD = {"goreci": "görevli", "isci": "işçi", "denetci": "denetçi"}
ROLLER = ("goreci", "isci", "denetci")
ARACLAR = ("claude", "codex", "opencode", "diger")
DURUM_AD = {
    "pending": "sırada", "assigned": "atandı",
    "pending_gorevli_review": "görevli incelemesi",
    "pending_verification": "teslim✋", "verified": "onaylı✅",
    "pending_revision": "revize✎", "dropped": "iptal🗑",
}
PANEL_VARSAYILAN = "http://localhost:8686"
HTTP_SN = 1.5
PANEL_ONLINE_SN = 30
KALP_ARALIK_UST = 20  # HTTP gecikmesi ve zamanlayıcı sapması için lease payı bırakır.


class VeriHatasi(Exception):
    """Kalıcı JSON verisi okunamadığında/bozuk olduğunda yükseltilir."""


def kalp_araligi(s):
    try:
        deger = int(s)
    except (TypeError, ValueError) as e:
        raise argparse.ArgumentTypeError("saniye cinsinden tam sayı gerekli") from e
    if not 1 <= deger <= KALP_ARALIK_UST:
        raise argparse.ArgumentTypeError(
            f"heartbeat aralığı 1-{KALP_ARALIK_UST} saniye olmalı")
    return deger


# ── temel yardımcılar ─────────────────────────────────────────────────

@contextlib.contextmanager
def kilit_tut(sn=10.0):
    """Süreçler arası ortak .kilit flock kilidi (bağlam yöneticisi)."""
    try:
        KILIT.parent.mkdir(parents=True, exist_ok=True)
        f = open(KILIT, "a+")
    except OSError as e:
        raise VeriHatasi(f"kilit dosyası açılamadı: {e}") from e
    try:
        son = time.monotonic() + sn
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= son:
                    raise VeriHatasi(
                        "kilit zaman aşımı: başka bir süreç kilidi bırakmadı")
                time.sleep(0.05)
            except OSError as e:
                raise VeriHatasi(f"kilit alınamadı: {e}") from e
        yield
    finally:
        try:
            fcntl.flock(f, fcntl.LOCK_UN)
        except OSError:
            pass
        f.close()


def yukle(p, varsayilan):
    """JSON okur; dosya yoksa varsayılan, varsa bozuklukta VeriHatasi verir."""
    p = Path(p)
    try:
        metin = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return varsayilan
    except (OSError, UnicodeError) as e:
        raise VeriHatasi(f"{p.name} okunamadı: {e}") from e
    if not metin.strip():
        return varsayilan
    try:
        veri = json.loads(metin)
    except Exception as e:
        raise VeriHatasi(f"{p.name} bozuk JSON: {e}") from e
    if not isinstance(veri, dict):
        raise VeriHatasi(f"{p.name} beklenen JSON nesnesi değil")
    return veri


def kaydet(p, v):
    """Atomik yazım; çağıran gerekliyse kilit_tut() içinde olmalıdır."""
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    try:
        mod = p.stat().st_mode & 0o777
    except FileNotFoundError:
        mod = 0o644
    fd = tmp = None
    yerine_koyuldu = False
    try:
        fd, tmp = tempfile.mkstemp(prefix=p.name + ".", suffix=".tmp",
                                   dir=str(p.parent))
        os.chmod(tmp, mod)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fd = None
            json.dump(v, fh, ensure_ascii=False, indent=1)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, p)
        yerine_koyuldu = True
        tmp = None
        dfd = os.open(str(p.parent), os.O_RDONLY |
                      getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError as e:
        if yerine_koyuldu:
            raise VeriHatasi(
                f"{p.name} değişmiş olabilir ancak üst dizin dayanıklılığı "
                f"doğrulanamadı; rollback veya yeniden deneme güvenli "
                f"varsayılamaz: {e}") from e
        raise
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def ekle_jsonl(yol, satir):
    yol = Path(yol)
    yol.parent.mkdir(parents=True, exist_ok=True)
    with kilit_tut():
        with open(yol, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(satir, ensure_ascii=False) + "\n")


def simdi():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def uid():
    return f"{int(time.time() * 1000):x}-{random.randint(1000, 9999)}"


def renkli(s, kod):
    return f"\x1b[{kod}m{s}\x1b[0m"


def guvenli(s):
    t = "".join(c if (c.isalnum() or c in "-_.") else "_" for c in str(s))[:64]
    return ("_" + t.lstrip(".")) if t.startswith(".") else (t or "yok")


def durum_oku():
    d = yukle(STATE, {"kullanicilar": {}, "rev": 0})
    d.setdefault("kullanicilar", {})
    d.setdefault("rev", 0)
    if not isinstance(d["kullanicilar"], dict):
        raise VeriHatasi("durum.json: 'kullanicilar' nesne olmalı")
    for kimlik, kisi in d["kullanicilar"].items():
        if not isinstance(kisi, dict):
            raise VeriHatasi(f"durum.json: '{kimlik}' kaydı nesne olmalı")
    return d


def coz_kimlik(anahtar, d=None):
    """Kimlik çözümleme: önce anahtar, sonra görünen ad."""
    ks = (d if d is not None else durum_oku())["kullanicilar"]
    if not anahtar:
        return None
    anahtar = str(anahtar)
    if anahtar in ks:
        return anahtar
    for k, v in ks.items():
        if str(v.get("ad") or k).lstrip("@").lower() == anahtar.lstrip("@").lower():
            return k
    return None


def goster_ad(kimlik):
    ks = durum_oku()["kullanicilar"]
    return ks.get(kimlik, {}).get("ad") or kimlik


def kisi_renk(ad):
    k = durum_oku()["kullanicilar"].get(ad, {})
    return RENK.get(k.get("arac", "diger"), RENK["diger"])


def durum_guncelle(fn):
    """durum.json üzerinde kilitli oku-değiştir-yaz."""
    with kilit_tut():
        d = durum_oku()
        sonuc = fn(d)
        kaydet(STATE, d)
        return sonuc


def sorumlu_dogrula(d, kimlik, sorumlu_kimlik, rol=None):
    if sorumlu_kimlik in (None, ""):
        return None, None
    ks = d["kullanicilar"]
    rol = rol or ks.get(kimlik, {}).get("rol", "isci")
    hedef = coz_kimlik(sorumlu_kimlik, d)
    if not hedef:
        return None, f"bilinmeyen sorumlu kimliği: {sorumlu_kimlik}"
    if hedef == kimlik:
        return None, "kimlik kendisini sorumlu gösteremez"
    hedef_v = ks[hedef]
    hedef_rol = hedef_v.get("rol", "isci")
    if rol in ("goreci", "isci") and hedef_rol == "denetci":
        return hedef, None
    if (rol == "denetci" and hedef_rol == "denetci"
            and hedef_v.get("bas_denetci")):
        return hedef, None
    return None, "görevli/işçi denetçiye; denetçi yalnız baş denetçiye bağlanabilir"


def kimlik_rol_gecis_dogrula(d, kimlik, yeni_rol, bas_denetci=False):
    ks = d["kullanicilar"]
    v = ks.get(kimlik, {})
    eski_rol = v.get("rol", "isci")
    if bas_denetci and yeni_rol != "denetci":
        return "baş denetçi yalnız denetçi rolünde olabilir"
    if yeni_rol != "denetci" and v.get("bas_denetci"):
        return "baş denetçinin rolü değişmeden önce baş denetçilik kaldırılmalı"
    baglilar = [k for k, x in ks.items() if x.get("sorumlu_kimlik") == kimlik]
    if yeni_rol != "denetci" and baglilar:
        return "ekip üyeleri bağlı; önce sorumlu bağlarını kaldırın veya yeniden atayın"
    sorumlu = v.get("sorumlu_kimlik")
    if sorumlu:
        _, hata = sorumlu_dogrula(d, kimlik, sorumlu, rol=yeni_rol)
        if hata:
            return "mevcut sorumlu bağı yeni rolle geçersiz: " + hata
    if eski_rol != "denetci" and yeni_rol == "denetci" and sorumlu:
        return "denetçi yapılacak kimliğin önce sorumlu bağı kaldırılmalı"
    return None


def bas_denetci_ata(d, kimlik, etkin):
    ks = d["kullanicilar"]
    v = ks.get(kimlik)
    if not v:
        return "bilinmeyen kimlik"
    if v.get("rol", "isci") != "denetci":
        return "baş denetçi yalnız denetçi rolünden seçilebilir"
    if etkin:
        eskiler = [k for k, x in ks.items()
                   if k != kimlik and x.get("bas_denetci")]
        if eskiler:
            for x in ks.values():
                if (x.get("rol") == "denetci"
                        and x.get("sorumlu_kimlik") in eskiler):
                    x["sorumlu_kimlik"] = kimlik
            for eski in eskiler:
                ks[eski]["bas_denetci"] = False
        v.pop("sorumlu_kimlik", None)
        v["bas_denetci"] = True
        return None
    if v.get("bas_denetci"):
        if any(k != kimlik and x.get("rol") == "denetci"
               and x.get("sorumlu_kimlik") == kimlik for k, x in ks.items()):
            return "baş denetçiye bağlı denetçiler var; önce onları yeniden atayın"
        v["bas_denetci"] = False
    return None


def kullanici_dokun(ad):
    def _dokun(d):
        k = d["kullanicilar"].setdefault(ad, {})
        k["son_gorulme"] = simdi()
        k.setdefault("katilma", simdi())
    durum_guncelle(_dokun)


def kime_norm(kime):
    """Hedefi '@hepsi' / '@<görünen ad>' biçimine getirir."""
    if not kime:
        return "@hepsi"
    k = str(kime).strip()
    if k.startswith("#"):
        return k
    hedef = k.lstrip("@")
    if hedef.lower() in ("hepsi", "all", "*", ""):
        return "@hepsi"
    kk = coz_kimlik(hedef)
    return "@" + (goster_ad(kk) if kk else hedef)


def mesaj_ekle(kimden, metin, kime="@hepsi", tur="not"):
    m = {"id": uid(), "ts": simdi(), "kimden": kimden, "kime": kime_norm(kime),
         "tur": tur, "metin": metin, "ad": goster_ad(kimden), "kanal": "sohbet"}
    ekle_jsonl(BUS, m)
    kullanici_dokun(kimden)
    return m


def mesajlar(n=50, filtre=None):
    if not BUS.exists():
        return []
    satirlar = BUS.read_text(encoding="utf-8", errors="replace").splitlines()[-n * 3:]
    ms = []
    for s in satirlar:
        try:
            m = json.loads(s)
        except Exception:
            continue
        m.setdefault("ad", m.get("kimden"))
        ms.append(m)
    if filtre:
        ms = [m for m in ms if filtre(m)]
    return ms[-n:]


def bana_gelen(ad, kimlik=None):
    hedefler = {"@hepsi", "@" + ad}
    if kimlik:
        hedefler.add("@" + kimlik)
    return [m for m in mesajlar(400)
            if m["kime"] in hedefler and m["kimden"] not in (ad, kimlik)]


# ── panel köprüsü (hata yutulur, CLI asla bloke olmaz) ────────────────

def panel_al(panel=None):
    return (panel or os.environ.get("YUVA_PANEL") or PANEL_VARSAYILAN).rstrip("/")


def http_iste(panel, yol, govde=None, sn=HTTP_SN):
    url = panel_al(panel) + yol
    try:
        if govde is None:
            istek = urllib.request.Request(url, method="GET")
        else:
            istek = urllib.request.Request(
                url, data=json.dumps(govde, ensure_ascii=False).encode("utf-8"),
                headers={"Content-Type": "application/json"}, method="POST")
        with urllib.request.urlopen(istek, timeout=sn) as r:
            return True, json.loads(r.read().decode("utf-8"))
    except Exception as e:
        return False, str(e)


def panel_veri(panel=None):
    ok, cevap = http_iste(panel, "/api/veri")
    return cevap if ok else None


def panel_kisi(kimlik, panel=None):
    v = panel_veri(panel)
    if not isinstance(v, dict):
        return None
    ks = v.get("kullanicilar")
    if not isinstance(ks, dict):
        return None
    return ks.get(kimlik)


# ── kalp atışı (yeşil ışık) ──────────────────────────────────────────

def daemon_kilit_dosyasi(kimlik):
    """Heartbeat sahiplik kilidi; dosya daemon ömrü boyunca kalır."""
    return KOK / f".kalp-{guvenli(kimlik)}.lock"


@contextlib.contextmanager
def kalp_kontrol_kilidi(kimlik):
    """Aynı kimliğin baglan/ayril/kalp-yok servis geçişlerini sıraya koy."""
    yol = KOK / f".kalp-{guvenli(kimlik)}.kontrol.lock"
    yol.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(str(yol), flags, 0o600)
    try:
        st = os.fstat(fd)
        pst = yol.lstat()
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid()
                or st.st_nlink != 1 or st.st_dev != pst.st_dev
                or st.st_ino != pst.st_ino or not stat.S_ISREG(pst.st_mode)):
            raise PermissionError("kalp kontrol kilidi beklenen güvenli dosya değil")
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def dur_dosyasi(kimlik):
    return KOK / f".kalp-{guvenli(kimlik)}.dur"


def saglik_dosyasi(kimlik):
    return KOK / f".kalp-{guvenli(kimlik)}.saglik.json"


def proc_baslangic(pid):
    """Linux /proc/<pid>/stat alan 22 (starttime); PID tekrar kullanımını ayırt eder."""
    try:
        stat = Path(f"/proc/{int(pid)}/stat").read_text(encoding="utf-8")
        return int(stat.rsplit(")", 1)[1].split()[19])
    except Exception:
        return None


def daemon_kilit_ac(kimlik, blokla=False):
    """Daemon sahipliğini PID kaydı/sinyali olmadan Linux flock ile al.

    FD çocuk süreçle pass_fds üzerinden paylaşılır; flock açık dosya
    tanıtıcısına bağlı olduğu için daemon yaşadığı sürece sahiplik korunur.
    """
    yol = daemon_kilit_dosyasi(kimlik)
    yol.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    fd = None
    sahip = False
    fd = os.open(str(yol), flags, 0o600)
    try:
        st = os.fstat(fd)
        pst = yol.lstat()
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid()
                or st.st_nlink != 1 or st.st_dev != pst.st_dev
                or st.st_ino != pst.st_ino or not stat.S_ISREG(pst.st_mode)):
            raise PermissionError("heartbeat kilidi beklenen güvenli dosya değil")
        op = fcntl.LOCK_EX
        if not blokla:
            op |= fcntl.LOCK_NB
        try:
            fcntl.flock(fd, op)
        except OSError as e:
            if not blokla and e.errno in (errno.EACCES, errno.EAGAIN):
                return None
            raise
        sahip = True
        return fd
    finally:
        # Sahiplik alınmadıysa FD'yi kapat; başarılı FD çağırana aktarılır.
        if fd is not None and not sahip:
            os.close(fd)


def daemon_kilit_fd_dogrula(fd, kimlik):
    """İç daemon'ın devraldığı FD'nin beklenen kilit dosyası olduğunu doğrula."""
    try:
        st = os.fstat(int(fd))
        pst = daemon_kilit_dosyasi(kimlik).lstat()
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid()
                or st.st_nlink != 1 or st.st_dev != pst.st_dev
                or st.st_ino != pst.st_ino or not stat.S_ISREG(pst.st_mode)):
            return False
        flags = fcntl.fcntl(int(fd), fcntl.F_GETFL)
        if flags & os.O_ACCMODE != os.O_RDWR:
            return False
        fcntl.flock(int(fd), fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except (OSError, ValueError, TypeError):
        return False


def _dur_yaz_locked(kimlik, neden):
    kaydet(dur_dosyasi(kimlik),
           {"ts": simdi(), "kimlik": kimlik, "neden": neden})


def dur_yaz(kimlik, neden):
    try:
        with kilit_tut():
            _dur_yaz_locked(kimlik, neden)
    except Exception:
        pass


def saglik_guncelle(kimlik, durum, hata=None, yonetim=None):
    """Sınırlı, kilitli yerel kalp sağlık durumu (son 20 olay)."""
    try:
        with kilit_tut():
            yol = saglik_dosyasi(kimlik)
            try:
                eski = yukle(yol, {})
            except VeriHatasi:
                eski = {}
            if not isinstance(eski, dict):
                eski = {}
            gecmis = eski.get("gecmis")
            if not isinstance(gecmis, list):
                gecmis = []
            ts = simdi()
            kayit = {"ts": ts, "durum": durum}
            if hata:
                kayit["hata"] = str(hata)[:500]
            onceki = eski.get("durum")
            if durum == "hata" or durum != onceki:
                gecmis.append(kayit)
            gecmis = gecmis[-20:]
            try:
                ardisik = int(eski.get("ardisik_hata") or 0)
            except Exception:
                ardisik = 0
            yeni = {
                "kimlik": kimlik,
                "ts": ts,
                "durum": durum,
                "ardisik_hata": ardisik,
                "son_hata": eski.get("son_hata"),
                "son_basari": eski.get("son_basari"),
                "gecmis": gecmis,
            }
            for alan in ("host_supervised", "host_instance", "host_token",
                         "host_root", "host_panel", "host_interval", "host_ttl",
                         "host_pid", "host_invocation", "host_root_dev",
                         "host_root_ino", "host_lock_dev", "host_lock_ino"):
                if yonetim is not None and alan in yonetim:
                    yeni[alan] = yonetim[alan]
                elif alan in eski:
                    yeni[alan] = eski[alan]
            if durum == "hata":
                yeni["ardisik_hata"] = ardisik + 1
                yeni["son_hata"] = str(hata or "bilinmeyen hata")[:500]
            elif durum == "ok":
                yeni["ardisik_hata"] = 0
                yeni["son_basari"] = ts
            kaydet(yol, yeni)
    except Exception:
        pass


def atalar():
    """Süreç zinciri: [(pid, comm), ...] — en yakın atadan dışa doğru."""
    zincir = []
    pid = os.getppid()
    for _ in range(16):
        if pid <= 1:
            break
        try:
            stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
            comm = stat.rsplit(")", 1)[0].split("(", 1)[1]
            ppid = int(stat.rsplit(")", 1)[1].split()[1])
        except Exception:
            break
        zincir.append((pid, comm))
        pid = ppid
    return zincir


def ata_pid_oku():
    """Kalp daemon'ının ömür ölçütü: model oturumu süreci.

    Sıra: (1) model/uygulama süreci (opencode/claude/codex) — komut çalıştıran alt
    kabuklar GEÇİCİ olduğu ve terminal sekmeleri yenilendiğinde öldüğü için en
    güvenilir çapa budur;
    (2) en dıştaki kabuk (terminal); (3) doğrudan ebeveyn.
    """
    zincir = atalar()
    oturum = [p for p, c in zincir
              if c.startswith(("opencode", "claude", "codex"))]
    if oturum:
        return oturum[0], zincir
    kabuklar = ("bash", "zsh", "sh", "fish", "ksh", "dash")
    kabuk = [p for p, c in zincir if c in kabuklar]
    if kabuk:
        return kabuk[-1], zincir
    return os.getppid(), zincir


DAEMON_HAZIRLIK_SURESI = 3.0


def host_birim(kimlik, panel):
    kim = hashlib.sha256((str(KOK.resolve()) + "\0" + kimlik + "\0" +
                          panel_al(panel)).encode()).hexdigest()[:20]
    return f"yuva-kalp-{kim}.service"


def host_kontrol_var_mi():
    if not (shutil.which("systemd-run") and shutil.which("systemctl")
            and os.environ.get("XDG_RUNTIME_DIR")):
        return False
    try:
        return subprocess.run([shutil.which("systemctl"), "--user",
                               "show-environment"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=2).returncode == 0
    except Exception:
        return False


def host_linger_durumu():
    """Kullanıcı manager'ının logout sonrasında açık tutulup tutulmadığı."""
    loginctl = shutil.which("loginctl")
    if not loginctl:
        return None
    try:
        p = subprocess.run([loginctl, "show-user", str(os.getuid()),
                            "--property=Linger", "--value"],
                           capture_output=True, text=True, timeout=2)
        if p.returncode:
            return None
        return p.stdout.strip().lower() == "yes"
    except Exception:
        return None


def host_birim_durumu(birim):
    p = subprocess.run([shutil.which("systemctl"), "--user", "show", birim,
                        "--property=LoadState", "--property=ActiveState",
                        "--property=MainPID", "--property=InvocationID",
                        "--no-pager"], capture_output=True, text=True, timeout=2)
    if p.returncode:
        raise RuntimeError(p.stderr.strip() or "systemctl show başarısız")
    sonuc = {}
    for satir in p.stdout.splitlines():
        if "=" in satir:
            anahtar, deger = satir.split("=", 1)
            sonuc[anahtar] = deger
    if sonuc.get("LoadState") in (None, "not-found"):
        return None
    return sonuc


def host_birim_durdur(birim):
    """Birim varsa durdurmayı bekle ve pasifliği doğrula."""
    durum = host_birim_durumu(birim)
    if durum is None or durum.get("ActiveState") not in (
            "active", "activating", "deactivating", "reloading"):
        return None
    p = subprocess.run([shutil.which("systemctl"), "--user", "stop", birim],
                       capture_output=True, text=True, timeout=15)
    if p.returncode:
        return p.stderr.strip() or f"systemctl stop çıkış kodu {p.returncode}"
    son = host_birim_durumu(birim)
    if son and son.get("ActiveState") in ("active", "activating", "deactivating"):
        return "systemctl stop sonrasında birim hâlâ etkin"
    return None


def kok_kilit_kimligi(kimlik):
    """KOK dizini ve heartbeat kilidinin gerçek device/inode kimliğini döndür."""
    kok = KOK.stat()
    kilit = daemon_kilit_dosyasi(kimlik).stat()
    return {"host_root_dev": int(kok.st_dev), "host_root_ino": int(kok.st_ino),
            "host_lock_dev": int(kilit.st_dev), "host_lock_ino": int(kilit.st_ino)}


def host_health_eslesiyor(saglik, kimlik, durum, birim, panel, sn, ttl,
                          token=None):
    try:
        kok_kimligi = kok_kilit_kimligi(kimlik)
        pid = int(saglik.get("host_pid") or 0)
        return (bool(durum) and durum.get("ActiveState") == "active" and
                pid > 1 and int(durum.get("MainPID") or 0) == pid and
                bool(durum.get("InvocationID")) and
                saglik.get("host_invocation") == durum.get("InvocationID") and
                saglik.get("host_supervised") is True and
                saglik.get("host_instance") == birim and
                saglik.get("host_root") == str(KOK.resolve()) and
                saglik.get("host_panel") == panel_al(panel) and
                saglik.get("host_interval") == max(1, int(sn)) and
                saglik.get("host_ttl") == max(0, int(ttl)) and
                all(saglik.get(k) == v for k, v in kok_kimligi.items()) and
                (token is None or saglik.get("host_token") == token) and
                saglik.get("durum") == "ok" and
                kalp_tarihi_taze(saglik.get("son_basari"), PANEL_ONLINE_SN))
    except Exception:
        return False


def kalp_tarihi_taze(iso, sn=30):
    try:
        t = datetime.fromisoformat(str(iso))
        if t.tzinfo is None:
            t = t.astimezone()
        yas = (datetime.now().astimezone() - t).total_seconds()
        return 0 <= yas <= sn
    except Exception:
        return False


def host_kalp_baslat(kimlik, sn, panel, ttl=0, kontrol_kilitli=False,
                     force_restart=False):
    """Kalp döngüsünü kullanıcı systemd yöneticisine devret ve invocation'ı doğrula."""
    if not host_kontrol_var_mi():
        return None, "kullanıcı systemd yöneticisi erişilebilir değil"
    sn = int(sn)
    ttl = max(0, int(ttl))
    if not 1 <= sn <= KALP_ARALIK_UST:
        return None, f"kalp aralığı 1-{KALP_ARALIK_UST} saniye olmalı"
    birim = host_birim(kimlik, panel)
    def _baslat():
        try:
            if dur_dosyasi(kimlik).exists():
                return None, "durdurma işareti var; heartbeat başlatılmadı"
            d = durum_oku()
            if not d["kullanicilar"].get(kimlik, {}).get("bagli"):
                return None, "kimlik bağlı değil; heartbeat başlatılmadı"
            durum = host_birim_durumu(birim)
            saglik = yukle(saglik_dosyasi(kimlik), {})
            if (not force_restart and host_health_eslesiyor(
                    saglik, kimlik, durum, birim, panel, sn, ttl)):
                return birim, None
            dur_hata = host_birim_durdur(birim)
            if dur_hata:
                return None, f"önceki heartbeat servisi durdurulamadı: {dur_hata}"
        except Exception as e:
            return None, f"host servisi denetlenemedi: {e}"

        def birim_temizle():
            try:
                return host_birim_durdur(birim)
            except Exception as e:
                return str(e)

        token = hashlib.sha256(os.urandom(32)).hexdigest()
        env = dict(os.environ)
        env["YUVA_DIR"] = str(KOK.resolve())
        env["YUVA_PANEL"] = panel_al(panel)
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        komut = [shutil.which("systemd-run"), "--user", "--no-block",
                 f"--unit={birim}", "--collect",
                 "--property=Restart=on-failure", "--property=RestartSec=2s",
                 "--property=KillMode=control-group"]
        for ad, deger in (("YUVA_DIR", env["YUVA_DIR"]),
                          ("YUVA_PANEL", env["YUVA_PANEL"]),
                          ("PYTHONDONTWRITEBYTECODE", "1")):
            komut.append(f"--setenv={ad}={deger}")
        komut += [sys.executable, str(CALISAN), "kalp-dongu", "--from", kimlik,
                  "--host-supervised", "--host-token", token,
                  "--host-instance", birim, "--sn", str(sn),
                  "--ttl", str(ttl), "--panel", panel_al(panel)]
        try:
            p = subprocess.run(komut, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               text=True, timeout=5, env=env)
            if p.returncode:
                mesaj = (p.stderr.strip() or p.stdout.strip() or
                         f"systemd-run çıkış kodu {p.returncode}")[:500]
                stop_hata = birim_temizle()
                if stop_hata:
                    mesaj += f"; başarısız birimi durdurma hatası: {stop_hata}"
                return None, mesaj
        except Exception as e:
            stop_hata = birim_temizle()
            mesaj = f"systemd-run başarısız: {e}"
            if stop_hata:
                mesaj += f"; başarısız birimi durdurma hatası: {stop_hata}"
            return None, mesaj

        son = time.monotonic() + DAEMON_HAZIRLIK_SURESI
        while time.monotonic() < son:
            try:
                saglik = yukle(saglik_dosyasi(kimlik), {})
                durum = host_birim_durumu(birim)
                if (saglik.get("host_token") == token and
                        host_health_eslesiyor(saglik, kimlik, durum, birim,
                                              panel, sn, ttl, token)):
                    return birim, None
                if (saglik.get("host_token") == token and
                        (not durum or durum.get("ActiveState") != "active")):
                    break
            except Exception:
                pass
            time.sleep(0.1)
        stop_hata = birim_temizle()
        mesaj = "host daemonı güncel systemd invocation'ı ve ilk panel heartbeat'iyle doğrulanamadı"
        if stop_hata:
            mesaj += f"; başarısız servisi durdurma hatası: {stop_hata}"
        return None, mesaj

    if kontrol_kilitli:
        return _baslat()
    try:
        with kalp_kontrol_kilidi(kimlik):
            return _baslat()
    except Exception as e:
        return None, f"kalp kontrol kilidi alınamadı: {e}"


def daemon_hazirlik_bekle(fd, sure=DAEMON_HAZIRLIK_SURESI):
    """Child'ın ilk heartbeat döngüsüne ulaştığını veya başlangıçta hata aldığını bekle."""
    son = time.monotonic() + sure
    veri = bytearray()
    while time.monotonic() < son:
        kalan = max(0, son - time.monotonic())
        hazir, _, _ = select.select([fd], [], [], kalan)
        if not hazir:
            return None
        parca = os.read(fd, 1024)
        if not parca:
            return veri.decode("utf-8", errors="replace") if veri else ""
        veri.extend(parca)
        if b"\n" in veri:
            return veri.split(b"\n", 1)[0].decode("utf-8", errors="replace")
    return None


def daemon_child_temizle(pr, bekle=0.5):
    """Readiness alınmayan child'ı kapat ve sonlanmasını bekle."""
    try:
        durum = pr.poll()
    except Exception:
        durum = None
    if durum is not None:
        try:
            pr.wait()
        except Exception:
            pass
        return
    try:
        pr.terminate()
    except Exception:
        pass
    try:
        pr.wait(timeout=bekle)
        return
    except subprocess.TimeoutExpired:
        pass
    except Exception:
        return
    try:
        pr.kill()
    except Exception:
        pass
    try:
        pr.wait()
    except Exception:
        pass


def daemon_baslat(kimlik, sn, panel, ttl=0, temizle_dur=False):
    try:
        ttl = int(ttl)
    except Exception:
        ttl = 0
    dur = dur_dosyasi(kimlik)
    hata = None
    ata = None
    # Bir önceki daemon .dur'u görmüş ve kapanmak üzereyken baglan --kalp
    # flock'u hâlâ dolu görebilir. Global state kilidini bırakıp sınırlı süre
    # yeniden dene; aynı anda başlayan süreçler yine daemon flock'unda tekilleşir.
    temizlendi = False
    deneme_sayisi = 5
    for deneme in range(deneme_sayisi):
        kilit_bekliyor = False
        kilit_fd = hazir_oku = hazir_yaz = None
        pr = None
        try:
            with kilit_tut():
                if dur.exists() and not (temizle_dur and not temizlendi):
                    return None, "durduruldu işareti var (önce baglan)", None
                if temizle_dur and not temizlendi:
                    dur.unlink(missing_ok=True)
                    temizlendi = True
                try:
                    kilit_fd = daemon_kilit_ac(kimlik, blokla=False)
                except OSError as e:
                    hata = f"heartbeat kilidi alınamadı: {e}"
                    break
                if kilit_fd is None:
                    kilit_bekliyor = True
                else:
                    try:
                        ata, _zincir = ata_pid_oku()
                        ata_baslangic = proc_baslangic(ata)
                        if ata <= 1 or ata_baslangic is None or ata_baslangic <= 0:
                            hata = "ebeveyn PID başlangıç zamanı okunamadı; fail-closed"
                            break
                        hazir_oku, hazir_yaz = os.pipe()
                        args = [sys.executable, str(CALISAN), "kalp-dongu", "--from", kimlik,
                                "--pid", str(ata), "--ata-baslangic", str(ata_baslangic),
                                "--sn", str(sn), "--ttl", str(ttl),
                                "--kilit-fd", str(kilit_fd),
                                "--hazirlik-fd", str(hazir_yaz),
                                "--panel", panel_al(panel)]
                        pr = subprocess.Popen(args, stdout=subprocess.DEVNULL,
                                              stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                                              start_new_session=True,
                                              pass_fds=(kilit_fd, hazir_yaz))
                        os.close(hazir_yaz)
                        hazir_yaz = None
                    except Exception as e:
                        hata = f"başlatılamadı: {e}"

            # Child readiness öncesinde saglik_guncelle/kullanici_dokun ile aynı
            # global state kilidini alır; pipe beklemesi kilit kapsamı dışındadır.
            if pr is not None and hata is None:
                try:
                    hazirlik = daemon_hazirlik_bekle(hazir_oku)
                    if hazirlik == "READY" and getattr(pr, "poll", lambda: None)() is not None:
                        hazirlik = "ERR: daemon readiness sonrasında hemen kapandı"
                    if hazirlik != "READY":
                        if hazirlik is None:
                            hata = "başlatma zaman aşımı: heartbeat daemonı hazır olmadı"
                        elif hazirlik.startswith("ERR:"):
                            hata = f"heartbeat daemonı başlatılamadı: {hazirlik[4:].strip()}"
                        else:
                            hata = "heartbeat daemonı hazır olmadan kapandı"
                        daemon_child_temizle(pr)
                    else:
                        return pr.pid, True, ata
                except Exception as e:
                    hata = f"başlatılamadı: {e}"
                    daemon_child_temizle(pr)
        except Exception as e:
            hata = f"başlatılamadı: {e}"
            if pr is not None:
                daemon_child_temizle(pr)
        finally:
            for fd in (hazir_oku, hazir_yaz, kilit_fd):
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
        if not kilit_bekliyor:
            break
        if deneme + 1 < deneme_sayisi:
            time.sleep(0.05)
    if not hata and kilit_bekliyor:
        return None, "kalp daemonı ortak kilit altında zaten çalışıyor", None
    if hata:
        saglik_guncelle(kimlik, "hata", hata)
        return None, hata, ata
    return None, "başlatılamadı: bilinmeyen hata", ata


def daemon_durdur(kimlik, neden="durduruldu"):
    with kilit_tut():
        _dur_yaz_locked(kimlik, neden)
        return True


def daemon_kapan(kimlik, neden, durdur=False):
    if durdur:
        dur_yaz(kimlik, neden)
    saglik_guncelle(kimlik, "durduruldu", neden)


def kalp_guven(kimlik, panel=None, sn=10):
    """Işığı canlı tut: kalp daemon'ı ölmüşse (ör. terminal/süreç yenilendi) yeniden başlat.

    `yuva ayril` ile ayrılan (bagli=False) veya durdurma işareti olan kimlik için
    kendiliğinden başlatmaz.
    """
    d = durum_oku()
    if not d["kullanicilar"].get(kimlik, {}).get("bagli"):
        return None
    if dur_dosyasi(kimlik).exists():
        return None
    try:
        saglik = yukle(saglik_dosyasi(kimlik), {})
        sn = min(KALP_ARALIK_UST,
                 max(1, int(saglik.get("host_interval") or sn)))
        ttl = max(0, int(saglik.get("host_ttl") or 0))
    except Exception:
        ttl = 0
    birim, hata = host_kalp_baslat(kimlik, sn, panel, ttl)
    if hata:
        saglik_guncelle(kimlik, "hata", f"host kalp doğrulanamadı: {hata}")
        print(f"⚠️ host heartbeat doğrulanamadı: {hata}")
    return None


def benzersiz_yerel(d, ad, haric=None):
    alinan = {str(v.get("ad") or k).lower(): k
              for k, v in d["kullanicilar"].items() if k != haric}
    temel = (str(ad or "").strip() or "misafir")[:24]
    if temel.lower() not in alinan:
        return temel
    i = 2
    while f"{temel}-{i}".lower() in alinan:
        i += 1
    return f"{temel}-{i}"


# ── komutlar ──────────────────────────────────────────────────────────

def baglan_geri_al(kimlik, panel):
    """Başarısız katılımda yerel state, marker, unit ve paneli ayrı ayrı kapat."""
    sorunlar = []
    try:
        with kilit_tut():
            d = durum_oku()
            kisi = d["kullanicilar"].get(kimlik)
            if kisi:
                kisi["bagli"] = False
                kisi.pop("son_kalp", None)
                kaydet(STATE, d)
    except Exception as e:
        sorunlar.append(f"yerel bağlı state temizliği başarısız: {e}")
    try:
        with kilit_tut():
            _dur_yaz_locked(kimlik, "bağlantı geri alındı")
    except Exception as e:
        sorunlar.append(f".dur işareti yazılamadı: {e}")
    try:
        if not host_kontrol_var_mi():
            sorunlar.append("systemd --user erişilemiyor; servis durdurması doğrulanamadı")
        else:
            hata = host_birim_durdur(host_birim(kimlik, panel))
            if hata:
                sorunlar.append(f"heartbeat servisi durdurulamadı: {hata}")
    except Exception as e:
        sorunlar.append(f"heartbeat servisi durdurulamadı: {e}")
    try:
        ok, cevap = http_iste(panel, "/api/ayril", {"kimlik": kimlik})
        if not ok or not isinstance(cevap, dict) or not cevap.get("ok"):
            sorunlar.append(f"panel ayril bildirimi başarısız: {cevap}")
    except Exception as e:
        sorunlar.append(f"panel ayril bildirimi başarısız: {e}")
    return sorunlar


def cmd_baglan(a):
    kimlik = coz_kimlik(a.kimlik) or a.kimlik
    panel = panel_al(a.panel)
    with kilit_tut():
        mevcut = durum_oku()
        if kimlik in mevcut["kullanicilar"]:
            hata = kimlik_rol_gecis_dogrula(mevcut, kimlik, a.rol)
            if hata:
                raise VeriHatasi(hata)
    if a.kalp and not host_kontrol_var_mi():
        raise VeriHatasi(
            "kalp güvenli biçimde başlatılamadı: kullanıcı systemd yöneticisi "
            "erişilemiyor. Sandbox dışındaki host terminalinde `systemctl --user "
            "status` ile kullanıcı yöneticisini doğrulayın ve aynı `yuva baglan` komutunu "
            "yeniden çalıştırın; yerel modda bağlanma yapılmadı.")
    aralik = int(a.kalp_sn)
    if a.kalp and not 1 <= aralik <= KALP_ARALIK_UST:
        raise VeriHatasi(f"--kalp-sn 1-{KALP_ARALIK_UST} saniye arasında olmalı")

    try:
        with kalp_kontrol_kilidi(kimlik):
            ok, cevap = http_iste(panel, "/api/katil",
                                  {"kimlik": kimlik, "arac": a.arac,
                                   "rol": a.rol, "ad": a.ad or kimlik})
            if not (ok and isinstance(cevap, dict) and cevap.get("ok")):
                raise VeriHatasi(f"panele bağlanılamadı ({panel}): {cevap}")
            try:
                with kilit_tut():
                    d = durum_oku()
                    k = d["kullanicilar"].setdefault(kimlik, {"katilma": simdi()})
                    zaten_bagli = bool(k.get("bagli"))
                    k.update({"arac": a.arac, "rol": a.rol, "bagli": True,
                              "son_gorulme": simdi()})
                    if not zaten_bagli:
                        k.pop("son_kalp", None)
                    k.setdefault("katilma", simdi())
                    if a.ad:
                        k["ad"] = benzersiz_yerel(d, a.ad, haric=kimlik)
                    k.setdefault("ad", kimlik)
                    kaydet(STATE, d)
                    # Marker ancak yeni bağlı state diske yazıldıktan sonra temizlenir.
                    dur_dosyasi(kimlik).unlink(missing_ok=True)
            except Exception:
                sorunlar = baglan_geri_al(kimlik, panel)
                ek = f"; geri alma sorunları: {'; '.join(sorunlar)}" if sorunlar else ""
                raise VeriHatasi(f"yerel bağlantı kaydı başarısız{ek}")
            ad = cevap.get("ad") or k.get("ad") or kimlik

            if a.kalp:
                birim, hata = host_kalp_baslat(
                    kimlik, aralik, panel, getattr(a, "kalp_ttl", 0),
                    kontrol_kilitli=True, force_restart=not zaten_bagli)
                if hata:
                    sorunlar = baglan_geri_al(kimlik, panel)
                    ek = f"; geri alma sorunları: {'; '.join(sorunlar)}" if sorunlar else ""
                    raise VeriHatasi(
                        f"host heartbeat başlatılamadı: {hata}. Sandbox dışındaki host "
                        "terminalinde `systemctl --user status` ile kullanıcı systemd "
                        f"oturumunu doğrulayıp komutu yeniden çalıştırın{ek}.")
            else:
                try:
                    with kilit_tut():
                        _dur_yaz_locked(kimlik, "kalp kapalı")
                except Exception as e:
                    sorunlar = baglan_geri_al(kimlik, panel)
                    ek = f"; geri alma sorunları: {'; '.join(sorunlar)}" if sorunlar else ""
                    raise VeriHatasi(f"kalp durdurma işareti yazılamadı: {e}{ek}")
                if host_kontrol_var_mi():
                    try:
                        hata = host_birim_durdur(host_birim(kimlik, panel))
                    except Exception as e:
                        hata = str(e)
                    if hata:
                        sorunlar = baglan_geri_al(kimlik, panel)
                        ek = f"; geri alma sorunları: {'; '.join(sorunlar)}" if sorunlar else ""
                        raise VeriHatasi(f"kalp servisi durdurulamadı: {hata}{ek}")
                    stop_uyari = None
                else:
                    stop_uyari = "systemd yöneticisi erişilemiyor; .dur işareti kapanışı bekliyor"
                saglik_guncelle(kimlik, "durduruldu",
                                "kalp kapalı (baglan --kalp-yok)")
    except OSError as e:
        raise VeriHatasi(f"kalp geçiş kilidi/işlemi başarısız: {e}") from e

    if a.kalp:
        print(f"   💚 host heartbeat doğrulandı (systemd --user: {birim})")
        if host_linger_durumu() is not True:
            print("   ⚠️ user manager logoutta kapanabilir; logout sonrası çalışma için "
                  "hostta `loginctl enable-linger \"$USER\"` ayarını yapıp canary ile doğrulayın. "
                  "Geçici unit reboot sonrası yeniden bağlanma gerektirir.")
    else:
        print("   ⚪ kalp kapalı (--kalp ile açılır; panelde çevrimdışı görünür)")
        if stop_uyari:
            print(f"   ⚠️ {stop_uyari}")
    print(f"bağlantı kaydedildi: ad={ad} (kimlik: {kimlik}) · "
          f"rol: {ROL_AD.get(a.rol, a.rol)} · panel: {panel}")
    print(f"   📬 gelen kutun: yuva gelen --from {kimlik}")


def cmd_kalp(a):
    ok, cevap = http_iste(a.panel, "/api/kalp", {"kimlik": a.from_})
    if ok and isinstance(cevap, dict) and cevap.get("ok"):
        saglik_guncelle(a.from_, "ok")
        kullanici_dokun(a.from_)
        print(f"💚 kalp gönderildi ({cevap.get('ad') or a.from_})")
    else:
        saglik_guncelle(a.from_, "hata", cevap)
        kullanici_dokun(a.from_)
        print(f"⚪ kalp panele iletilemedi ({goster_ad(a.from_)}) — "
              "panel çevrimiçi durumu güncellenmedi")


def cmd_kalp_dongu(a):
    kimlik = a.from_
    host = bool(getattr(a, "host_supervised", False))
    kilit_fd = getattr(a, "kilit_fd", None)
    hazirlik_fd = getattr(a, "hazirlik_fd", None)
    hazirlik_bildirildi = False
    yonetim = None

    def hazirlik_bildir(mesaj):
        nonlocal hazirlik_bildirildi
        if hazirlik_fd is None or hazirlik_bildirildi:
            return
        try:
            os.write(hazirlik_fd, (mesaj + "\n").encode("utf-8", errors="replace")[:1024])
        except OSError:
            pass
        hazirlik_bildirildi = True

    if host:
        if not getattr(a, "host_token", None) or not getattr(a, "host_instance", None):
            hazirlik_bildir("ERR: host supervisor token/instance yok")
            return
        yonetim = {"host_supervised": True,
                   "host_instance": a.host_instance,
                   "host_token": a.host_token,
                   "host_root": str(KOK.resolve()),
                   "host_panel": panel_al(a.panel),
                   "host_interval": max(1, int(a.sn)),
                   "host_ttl": max(0, int(a.ttl)),
                   "host_pid": os.getpid(),
                   "host_invocation": os.environ.get("INVOCATION_ID")}
        if not yonetim["host_invocation"]:
            saglik_guncelle(kimlik, "hata", "systemd invocation kimliği yok", yonetim)
            return
        try:
            kilit_fd = daemon_kilit_ac(kimlik, blokla=False)
        except Exception as e:
            saglik_guncelle(kimlik, "hata", f"host flock alınamadı: {e}", yonetim)
            return
        if kilit_fd is None:
            # Önceki candidate daemon kapanırken flock bırakmasını bekle.
            bitis_bekle = time.monotonic() + 15
            while time.monotonic() < bitis_bekle:
                if dur_dosyasi(kimlik).exists():
                    return
                d = durum_oku()
                if not d["kullanicilar"].get(kimlik, {}).get("bagli"):
                    return
                time.sleep(0.2)
                try:
                    kilit_fd = daemon_kilit_ac(kimlik, blokla=False)
                except Exception:
                    kilit_fd = None
                if kilit_fd is not None:
                    break
            if kilit_fd is None:
                saglik_guncelle(kimlik, "hata", "host flock başka daemon tarafından tutuluyor", yonetim)
                return
        try:
            yonetim.update(kok_kilit_kimligi(kimlik))
            if os.fstat(kilit_fd).st_dev != yonetim["host_lock_dev"] or \
                    os.fstat(kilit_fd).st_ino != yonetim["host_lock_ino"]:
                raise VeriHatasi("host flock device/inode doğrulaması uyuşmuyor")
        except Exception as e:
            saglik_guncelle(kimlik, "hata", f"host KOK/lock doğrulanamadı: {e}", yonetim)
            os.close(kilit_fd)
            return
    elif (kilit_fd is None or not daemon_kilit_fd_dogrula(kilit_fd, kimlik) or
          int(getattr(a, "pid", 0) or 0) <= 1 or
          int(getattr(a, "ata_baslangic", 0) or 0) <= 0):
        saglik_guncelle(kimlik, "hata", "flock veya ebeveyn başlangıç zamanı doğrulanamadı")
        hazirlik_bildir("ERR: flock veya ebeveyn başlangıç zamanı doğrulanamadı")
        return

    if not host and not daemon_kilit_fd_dogrula(kilit_fd, kimlik):
        saglik_guncelle(kimlik, "hata", "heartbeat kilit FD'si doğrulanamadı")
        hazirlik_bildir("ERR: heartbeat kilit FD'si doğrulanamadı")
        if hazirlik_fd is not None:
            try:
                os.close(hazirlik_fd)
            except OSError:
                pass
        return
    panel = panel_al(a.panel)
    bitis = time.time() + a.ttl if a.ttl > 0 else None
    ata_baslangic = getattr(a, "ata_baslangic", 0) or None
    try:
        saglik_guncelle(kimlik, "basladi")
        while bitis is None or time.time() < bitis:
            if not host and a.pid:
                guncel_baslangic = proc_baslangic(a.pid)
                if (guncel_baslangic is None or
                        (ata_baslangic is not None and
                         guncel_baslangic != int(ata_baslangic))):
                    daemon_kapan(kimlik, "ebeveyn süreç yok")
                    hazirlik_bildir("ERR: ebeveyn süreç yok")
                    return
            if dur_dosyasi(kimlik).exists():
                daemon_kapan(kimlik, "ayrilma işareti")
                hazirlik_bildir("ERR: ayrılma işareti var")
                return
            d = durum_oku()
            kisi = d["kullanicilar"].get(kimlik)
            if not kisi or not kisi.get("bagli"):
                daemon_kapan(kimlik, "bagli=false veya kullanıcı yok")
                hazirlik_bildir("ERR: kullanıcı bağlı değil")
                return
            ok, cevap = http_iste(panel, "/api/kalp", {"kimlik": kimlik}, sn=1.0)
            if ok and isinstance(cevap, dict) and cevap.get("ok"):
                saglik_guncelle(kimlik, "ok", yonetim=yonetim)
                hazirlik_bildir("READY")
            else:
                saglik_guncelle(kimlik, "hata", cevap, yonetim)
                hazirlik_bildir(f"ERR: ilk panel heartbeat başarısız: {cevap}")
                if not host:
                    return
            time.sleep(max(1, a.sn))
        daemon_kapan(kimlik, "ttl doldu", durdur=True)
    except Exception as e:
        daemon_kapan(kimlik, f"kalp döngüsü hatası: {e}")
        hazirlik_bildir(f"ERR: kalp döngüsü hatası: {e}")
        if host:
            raise
    finally:
        for fd in (kilit_fd, hazirlik_fd):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass


def cmd_ayril(a):
    on_kimlik = coz_kimlik(a.from_, durum_oku()) or a.from_
    sorunlar = []
    with kalp_kontrol_kilidi(on_kimlik):
        etkin = on_kimlik
        try:
            with kilit_tut():
                d = durum_oku()
                k = coz_kimlik(a.from_, d)
                etkin = k or on_kimlik
                if k and k in d["kullanicilar"]:
                    d["kullanicilar"][k]["bagli"] = False
                    kaydet(STATE, d)
        except Exception as e:
            sorunlar.append(f"yerel bağlı state güncellenemedi: {e}")
        try:
            with kilit_tut():
                _dur_yaz_locked(etkin, "ayril")
        except Exception as e:
            sorunlar.append(f".dur işareti yazılamadı: {e}")
        stop_hata = None
        if host_kontrol_var_mi():
            try:
                stop_hata = host_birim_durdur(host_birim(etkin, a.panel))
            except Exception as e:
                stop_hata = str(e)
        try:
            saglik_guncelle(etkin, "durduruldu", "ayril")
        except Exception as e:
            sorunlar.append(f"yerel heartbeat sağlık kaydı güncellenemedi: {e}")
        ok, cevap = http_iste(a.panel, "/api/ayril", {"kimlik": etkin})
    sonuc = f"⚫ ayrıldın ({goster_ad(etkin)}) · panel: {'🟢 bildirildi' if ok else '⚪ ulaşılamadı'}"
    if stop_hata:
        sonuc += f" · ⚠️ heartbeat servisi durdurma hatası: {stop_hata}"
    elif not host_kontrol_var_mi():
        sonuc += " · ⚠️ systemd yöneticisine erişilemedi; .dur işareti kapanışı bekliyor"
    if not ok:
        sonuc += f" ({cevap})"
    if sorunlar:
        sonuc += " · ⚠️ " + "; ".join(sorunlar)
    print(sonuc)


def cmd_ad(a):
    def _ad(d):
        k = coz_kimlik(a.from_, d) or a.from_
        v = d["kullanicilar"].setdefault(k, {"katilma": simdi()})
        eski = v.get("ad") or k
        v["ad"] = benzersiz_yerel(d, a.yeni, haric=k if k in d["kullanicilar"] else None)
        return k, v["ad"], eski

    k, yeni_ad, eski = durum_guncelle(_ad)
    http_iste(a.panel, "/api/ad", {"kimlik": k, "ad": yeni_ad})
    print(f"🏷️ adın artık: {yeni_ad}" + ("" if yeni_ad == eski else f" ({eski} idi)"))


def cmd_ekran(a):
    if a.satir and a.satir[0] == "oku":
        return cmd_ekran_oku(a)
    if not a.satir:
        sys.exit('kullanım: yuva ekran "satır" --from <kimlik>  |  yuva ekran oku')
    from_ = a.from_ or os.environ.get("YUVA_KIMLIK")
    if not from_:
        sys.exit("--from <kimlik> gerekli (veya YUVA_KIMLIK ortam değişkeni)")
    kimlik = coz_kimlik(from_) or from_
    metin = " ".join(a.satir)
    ok, cevap = http_iste(a.panel, "/api/ekran",
                          {"kimlik": kimlik, "satir": metin, "tur": a.tur})
    if ok and isinstance(cevap, dict) and cevap.get("ok"):
        kullanici_dokun(kimlik)
        kalp_guven(kimlik, a.panel)
        return                      # panel yazdı (aynı dosya) → çift satır olmasın
    ekle_jsonl(EKRAN / (guvenli(kimlik) + ".jsonl"),
               {"ts": simdi(), "kimlik": kimlik, "ad": goster_ad(kimlik),
                "tur": a.tur, "satir": metin})
    kullanici_dokun(kimlik)
    kalp_guven(kimlik, a.panel)
    print("⚠️ panel kapalı — ekran yalnız yerel yazıldı")


def cmd_ekran_oku(a):
    dosyalar = []
    if a.from_:
        k = coz_kimlik(a.from_) or a.from_
        dosyalar = [EKRAN / (guvenli(k) + ".jsonl")]
    elif EKRAN.exists():
        dosyalar = sorted(EKRAN.glob("*.jsonl"))
    if not dosyalar:
        print("(henüz ekran yok)")
        return
    for f in dosyalar:
        if not f.exists():
            continue
        satirlar = []
        for s in f.read_text(encoding="utf-8", errors="replace").splitlines()[-a.n:]:
            try:
                satirlar.append(json.loads(s))
            except Exception:
                continue
        if not satirlar:
            continue
        kimlik = satirlar[-1].get("kimlik") or f.stem
        ad = satirlar[-1].get("ad") or goster_ad(kimlik)
        print(renkli(f"── 🖥️ {ad} ({kimlik}) ──", "1;90"))
        for s in satirlar:
            im = {"komut": "$", "sonuc": "→", "baslik": "##"}.get(s.get("tur"), " ")
            print(f"  {renkli(s.get('ts', '')[5:16], '90')} {renkli(im, '36')} {s.get('satir', '')}")


def cmd_durum(a):
    kimlik = coz_kimlik(a.from_) or a.from_
    d = durum_oku()
    v = d["kullanicilar"].get(kimlik, {})
    ad = v.get("ad") or kimlik
    rol = v.get("rol", "isci")
    online = None
    pv_all = panel_veri(a.panel)
    pks = pv_all.get("kullanicilar") if isinstance(pv_all, dict) else None
    panel_ok = isinstance(pks, dict)
    pv = pks.get(kimlik) if panel_ok else None
    if isinstance(pv, dict):
        ad = pv.get("ad") or ad
        rol = pv.get("rol") or rol
        online = bool(pv.get("online"))
        v = dict(v, bas_denetci=pv.get("bas_denetci"))
    elif panel_ok:
        online = False
    bd = " 🔍 BAŞ DENETÇİ" if v.get("bas_denetci") else ""
    okunmamis = [m for m in bana_gelen(ad, kimlik)
                 if m["ts"] > (v.get("son_okuma") or "")]
    gb = gorev_yukle()
    benim = [g for g in gb["gorevler"] if g.get("assignee") in (kimlik, ad)
             and g["durum"] in ("assigned", "pending_revision")]
    panel_txt = ("🟢 bağlı" if online is True else
                 "⚪ çevrimdışı" if online is False else
                 "⚪ bilinmiyor")
    print(f"👤 {ad} ({kimlik}) · {v.get('arac', 'diger')} · rol: {ROL_AD.get(rol, rol)}{bd}"
          f" · panel {panel_txt}"
          f" · son görülme {(v.get('son_gorulme') or '?')[11:16]}"
          f" · okunmamış: {len(okunmamis)} · bekleyen görev: {len(benim)}")


def cmd_katil(a):
    cmd_baglan(a)


def cmd_kimler(a):
    ks = durum_oku()["kullanicilar"]
    if not ks:
        print("Kimse yok. `yuva baglan <takma-ad> --arac <claude|codex|opencode>`")
        return
    pv = panel_veri(a.panel)
    pks = pv.get("kullanicilar") if isinstance(pv, dict) else None
    panel_ok = isinstance(pks, dict)
    if not panel_ok:
        pks = {}
        print("⚠️ panel verisi alınamadı — çevrimiçi durum bilinmiyor (⚪)")
    for ad, k in sorted(ks.items(), key=lambda x: (x[1].get("ad") or x[0])):
        p = pks.get(ad, {}) if panel_ok else {}
        if not isinstance(p, dict):
            p = {}
        online = bool(p.get("online")) if panel_ok else False
        gorunen = p.get("ad") or k.get("ad") or ad
        isik = "🟢" if panel_ok and online else "⚪"
        bd = " 🔍" if (p.get("bas_denetci") or k.get("bas_denetci")) else ""
        print(f"{isik} {renkli(gorunen, kisi_renk(ad)):20} "
              f"{ROL_AD.get(k.get('rol'), '?'):8} "
              f"[{k.get('arac', '?')}] {renkli(ad, '90')} son: {(k.get('son_gorulme') or '?')[11:19]}{bd}")


def cmd_sorumlu(a):
    kimlik = coz_kimlik(a.kimlik)
    if not kimlik:
        raise VeriHatasi(f"bilinmeyen kimlik: {a.kimlik}")
    hedef = None if a.kaldir else coz_kimlik(a.denetci)
    if not a.kaldir and not hedef:
        raise VeriHatasi(f"bilinmeyen denetçi: {a.denetci}")
    with kilit_tut():
        d = durum_oku()
        if a.kaldir:
            d["kullanicilar"][kimlik].pop("sorumlu_kimlik", None)
        else:
            hedef, hata = sorumlu_dogrula(d, kimlik, hedef)
            if hata:
                raise VeriHatasi(hata)
            d["kullanicilar"][kimlik]["sorumlu_kimlik"] = hedef
        kaydet(STATE, d)
    print(f"✅ {kimlik}: sorumlu {hedef or 'kaldırıldı'}")


def cmd_bas_denetci(a):
    if bool(a.kaldir) == bool(a.kimlik):
        raise VeriHatasi("bir denetçi kimliği verin veya yalnız --kaldir kullanın")
    kimlik = None if a.kaldir else coz_kimlik(a.kimlik)
    if not a.kaldir and not kimlik:
        raise VeriHatasi(f"bilinmeyen kimlik: {a.kimlik}")
    with kilit_tut():
        d = durum_oku()
        if a.kaldir:
            kimlik = next((k for k, v in d["kullanicilar"].items()
                           if v.get("bas_denetci")), None)
            if not kimlik:
                print("Baş denetçi atanmamış")
                return
        hata = bas_denetci_ata(d, kimlik, not a.kaldir)
        if hata:
            raise VeriHatasi(hata)
        kaydet(STATE, d)
    print(f"✅ baş denetçi {'kaldırıldı' if a.kaldir else 'atandı'}: {kimlik}")


def msaj_satir(m, kimin):
    kd = kisi_renk(m["kimden"])
    kime = "" if m["kime"] == "@hepsi" else f" → {m['kime']}"
    tur = {"soru": "❓", "cevap": "↩", "rapor": "📦", "denetim": "🔍",
           "gorev": "📋", "durum": "·"}.get(m.get("tur", "not"), "")
    ad = m.get("ad") or m["kimden"]
    return (f"{renkli(m['ts'][5:16], '90')} "
            f"{renkli(ad, kd)}{renkli(kime, '90')} {tur} "
            f"{m['metin']}")


def cmd_yaz(a):
    hedef = a.to or "@hepsi"
    ok, cevap = http_iste(a.panel, "/api/yaz", {"kimden": a.from_, "metin": a.metin,
                                               "kime": hedef, "tur": a.tur})
    if ok and isinstance(cevap, dict) and cevap.get("ok"):
        kalp_guven(a.from_, a.panel)
        return                      # panel yazdı (aynı dosya) → çift kayıt olmasın
    if ok:
        sys.exit(f"⚠️ panel reddetti: {(cevap or {}).get('hata')}")
    mesaj_ekle(a.from_, a.metin, kime=hedef, tur=a.tur)   # panel yoksa yerel
    kalp_guven(a.from_, a.panel)


def cmd_oku(a):
    ms = mesajlar(a.n)
    if a.user:
        u = coz_kimlik(a.user) or a.user
        ms = [m for m in ms if m["kimden"] in (a.user, u) or m["kime"] in ("@" + a.user, "@" + u)]
    for m in ms:
        print(msaj_satir(m, a.from_))


def cmd_gelen(a):
    ad = a.from_
    kimlik = coz_kimlik(ad) or ad
    kullanici_dokun(kimlik)
    d = durum_oku()
    kisi = d["kullanicilar"].get(kimlik, {})
    ad = kisi.get("ad") or kimlik
    rol = kisi.get("rol", "isci")
    pv = panel_kisi(kimlik, getattr(a, "panel", None))
    if pv:
        ad = pv.get("ad") or ad
        rol = pv.get("rol") or rol
    # kimlik kartı
    cmd_durum(argparse.Namespace(from_=kimlik, panel=getattr(a, "panel", None)))
    # 1) mesajlar
    ozel = bana_gelen(ad, kimlik) + [
        m for m in mesajlar(120) if m["kimden"] == "kullanici" and m["kime"] == "@hepsi"]
    gorulen = {}
    for m in ozel:
        gorulen[m["id"]] = m
    ozel = sorted(gorulen.values(), key=lambda m: m["ts"])
    print(renkli("── 📬 mesajlar (son 15) ──", "1;90"))
    for m in ozel[-15:]:
        print(msaj_satir(m, ad))
    if not ozel:
        print("  (boş)")
    # 2) görevler
    gb = gorev_yukle()
    benim = [g for g in gb["gorevler"] if g.get("assignee") in (kimlik, ad) and
             g["durum"] in ("assigned", "pending_revision")]
    print(renkli("── 📋 görevlerin ──", "1;90"))
    for g in benim:
        ek = "  ✎ REVIZE GEREKLI!" if g["durum"] == "pending_revision" else ""
        print(f"  #{g['id']} {g['baslik']}{ek}")
        for n in g["gecmis"][-3:]:
            if n["not"]:
                print(f"      └ {n['kimden']}: {n['not']}")
    if not benim:
        print("  (atanan görev yok)")
    if rol == "goreci":
        ilk_kontrol = [g for g in gb["gorevler"]
                       if g.get("durum") == "pending_gorevli_review"
                       and g.get("gorevli_kimlik") == kimlik]
        if ilk_kontrol:
            print(renkli("── 🧰 İLK KONTROLÜ BEKLEYEN GÖREVLER ──", "1;33"))
            for g in ilk_kontrol:
                print(f"  #{g['id']} {g['baslik']}  (yuva gorev ilk-kontrol {g['id']} --onayla|--revize --from {kimlik})")
        bekleyen = [g for g in gb["gorevler"] if g["durum"] == "pending"]
        if bekleyen:
            print(renkli("── ⏳ SEN DAĞITICISIN: atamayı bekleyen görevler ──", "1;33"))
            for g in bekleyen:
                print(f"  #{g['id']} {g['baslik']}  (yuva gorev ata {g['id']} <ad>)")
    if rol == "denetci":
        bas = bool(kisi.get("bas_denetci"))
        kuyruk = [g for g in gb["gorevler"]
                  if g["durum"] == "pending_verification"
                  and (bas or not g.get("inceleyen_kimlik")
                       or g.get("inceleyen_kimlik") == kimlik)]
        if bas:
            yukler = {}
            for kisi_id, kisi_v in d["kullanicilar"].items():
                if kisi_v.get("rol") == "denetci" and kisi_id != kimlik:
                    yukler[kisi_id] = sum(
                        1 for g in gb["gorevler"]
                        if g["durum"] == "pending_verification"
                        and g.get("inceleyen_kimlik") == kisi_id)
            print(renkli("── 🔍 DENETÇİ İŞ YÜKÜ (bekleyen inceleme) ──", "1;90"))
            for kisi_id, adet in sorted(yukler.items()):
                print(f"  {goster_ad(kisi_id)} ({kisi_id}): {adet}")
        if kuyruk:
            print(renkli("── 🔍 SEN DENETÇİSİN: denetleme kuyruğu ──", "1;33"))
            for g in kuyruk:
                print(f"  #{g['id']} {g['baslik']}  (yuva gorev denetle {g['id']} --onayla|--revize)")
    # okundu işareti (kilitli oku-değiştir-yaz)
    def _okundu(d):
        if kimlik in d["kullanicilar"]:
            d["kullanicilar"][kimlik]["son_okuma"] = simdi()

    durum_guncelle(_okundu)


def cmd_tahta(a):
    gb = gorev_yukle()
    print(renkli("🪹 GÖREV TAHTASI", "1;36"))
    for g in gb["gorevler"]:
        d = DURUM_AD.get(g["durum"], g["durum"])
        renk = {"verified": "32", "pending_verification": "33",
                "pending_gorevli_review": "35",
                "pending_revision": "31", "assigned": "36",
                "pending": "90", "dropped": "90"}.get(g["durum"], "0")
        print(f"  #{g['id']:>3} {renkli(f'{d:9}', renk)} "
              f"{renkli(g['kimden'], '90')}→{renkli(g.get('assignee') or '-', '90')} "
              f"{g['baslik']}")


def kanonik_gorev_id(deger):
    """Pozitif görev ID'sini yalnız kanonik ASCII ondalık biçimden al."""
    if isinstance(deger, bool):
        raise ValueError("boolean görev ID olamaz")
    if isinstance(deger, int):
        if deger < 1:
            raise ValueError("görev ID pozitif olmalı")
        return deger
    if (not isinstance(deger, str) or not deger
            or deger[0] not in "123456789"
            or any(karakter not in "0123456789" for karakter in deger[1:])):
        raise ValueError("kanonik pozitif tamsayı gerekli")
    return int(deger)


def gorev_id_arg(deger):
    try:
        return kanonik_gorev_id(deger)
    except ValueError as e:
        raise argparse.ArgumentTypeError(
            "--ust-gorev başında sıfır/boşluk olmayan pozitif tamsayı olmalı") from e


def gorev_yukle():
    gb = yukle(GOREV, {"siradaki": 1, "gorevler": []})
    gb.setdefault("siradaki", 1)
    gb.setdefault("gorevler", [])
    if not isinstance(gb["siradaki"], int) or isinstance(gb["siradaki"], bool):
        raise VeriHatasi("gorevler.json: 'siradaki' tam sayı olmalı")
    if not isinstance(gb["gorevler"], list):
        raise VeriHatasi("gorevler.json: 'gorevler' liste olmalı")
    for g in gb["gorevler"]:
        if not isinstance(g, dict):
            raise VeriHatasi("gorevler.json: görev kaydı nesne olmalı")
        if "id" not in g:
            raise VeriHatasi("gorevler.json: görev kaydında 'id' yok")
        if "ust_gorev_id" in g:
            ust_id = g["ust_gorev_id"]
            if (ust_id is not None
                    and (isinstance(ust_id, bool) or not isinstance(ust_id, int)
                         or ust_id < 1)):
                raise VeriHatasi(
                    f"gorevler.json: #{g.get('id')} 'ust_gorev_id' pozitif tamsayı veya null olmalı")
        for alan in ("baslik", "kimden", "durum"):
            if not isinstance(g.get(alan), str):
                raise VeriHatasi(
                    f"gorevler.json: #{g.get('id')} '{alan}' metin olmalı")
        g.setdefault("gecmis", [])
        if not isinstance(g["gecmis"], list):
            raise VeriHatasi(f"gorevler.json: #{g.get('id')} 'gecmis' liste olmalı")
    return gb


def gorev_bul(gb, gid):
    for g in gb["gorevler"]:
        if str(g["id"]) == str(gid):
            return g
    return None


def gorev_eslesmeleri(gb, gid):
    """Kanonik ID'ye karşılık gelen kayıtları döndür; parent tekil olmalı."""
    return [g for g in gb["gorevler"] if str(g["id"]) == str(gid)]


def ust_gorev_dogrula(gb, ust_id, yeni_id):
    """Parent'ın tekil olduğunu ve yeni kenarın döngü üretmediğini doğrula."""
    if gorev_eslesmeleri(gb, yeni_id):
        return "sonraki görev ID'si zaten kullanımda; gorevler.json siradaki değerini düzeltin"
    if ust_id is None:
        return None
    eslesen = gorev_eslesmeleri(gb, ust_id)
    if not eslesen:
        return f"üst görev bulunamadı: #{ust_id}"
    if len(eslesen) != 1:
        return f"üst görev ID'si tekil değil: #{ust_id}"

    gorulen = set()
    gezilen_id = ust_id
    while gezilen_id is not None:
        if gezilen_id == yeni_id:
            return "üst görev zinciri yeni görev ID'sine geri dönüyor; döngü reddedildi"
        if gezilen_id in gorulen:
            return "üst görev zincirinde mevcut döngü var; parent atanamaz"
        gorulen.add(gezilen_id)
        zincir = gorev_eslesmeleri(gb, gezilen_id)
        if len(zincir) != 1:
            if not zincir:
                break  # Önceden bozuk, dışarıda kalan bir ileri referans.
            return f"üst görev zincirindeki ID tekil değil: #{gezilen_id}"
        kayit = zincir[0]
        if "ust_gorev_id" not in kayit:
            break  # Legacy görev; bilinen bir üst kenarı yok.
        gezilen_id = kayit["ust_gorev_id"]
    return None


def gorev_olay_ekle(g, kimden, olay, not_metni=None):
    g["guncelleme"] = simdi()
    olaylar = g.setdefault("gecmis", [])
    olaylar.append({"ts": simdi(), "kimden": kimden, "olay": olay,
                    "not": not_metni or ""})


# Görev geçişleri (fail-closed; tümü gorev_guncelle kilidi altında):
#   pending|pending_revision --al--> assigned (assignee varsa yalnız o)
#   pending|assigned|pending_revision --ata--> assigned
#   assigned --teslim(assignee)--> pending_gorevli_review (gorevli_kimlik varsa)
#   assigned --teslim(assignee)--> pending_verification (legacy, gorevli yoksa)
#   pending_gorevli_review --ilk-kontrol(gorevli)--> pending_verification|pending_revision
#   pending_verification --denetle--> verified|pending_revision
#   pending|assigned|pending_revision|pending_gorevli_review|pending_verification --iptal--> dropped
#   verified|dropped terminal
def gorev_guncelle(fn):
    """gorevler.json üzerinde kilitli oku-değiştir-yaz."""
    with kilit_tut():
        gb = gorev_yukle()
        sonuc = fn(gb)
        kaydet(GOREV, gb)
        return sonuc


def cmd_gorev_ekle(a):
    ata = coz_kimlik(a.ata) or a.ata
    ust_gorev_id = a.ust_gorev_id

    def _ekle(gb):
        gorevli, hata = gorevli_kimligi_dogrula(a.gorevli, durum_oku())
        if hata:
            sys.exit(hata)
        yeni_id = gb["siradaki"]
        hata = ust_gorev_dogrula(gb, ust_gorev_id, yeni_id)
        if hata:
            sys.exit(hata)
        g = {"id": gb["siradaki"], "baslik": a.baslik, "detay": a.detay or "",
             "kimden": a.from_, "assignee": ata,
             "gorevli_kimlik": gorevli,
             "ust_gorev_id": ust_gorev_id,
             "durum": "assigned" if ata else "pending",
             "olusturma": simdi(), "guncelleme": simdi(), "gecmis": []}
        gb["siradaki"] += 1
        gb["gorevler"].append(g)
        gorev_olay_ekle(g, a.from_, "olusturuldu")
        return g

    g = gorev_guncelle(_ekle)
    kullanici_dokun(a.from_)
    mesaj_ekle(a.from_, f"📋 görev #{g['id']}: {a.baslik}"
               + (f" → @{goster_ad(ata)}" if ata else " (atanmayı bekliyor)"),
               kime=(ata or "@hepsi"), tur="gorev")
    print(f"✅ #{g['id']} eklendi")


def cmd_gorev_ata(a):
    kime = (coz_kimlik(a.kime) or a.kime) if a.kime else None
    def _ata(gb):
        g = gorev_bul(gb, a.id)
        if not g:
            sys.exit(f"Görev #{a.id} yok")
        durum = g.get("durum")
        yeni_gorevli = None
        if a.gorevli:
            yeni_gorevli, hata = gorevli_kimligi_dogrula(a.gorevli, durum_oku())
            if hata:
                sys.exit(hata)
        if durum == "pending_gorevli_review":
            if kime:
                sys.exit("ilk kontrol kuyruğunda assignee değişmez; yalnız --gorevli verin")
            if not yeni_gorevli:
                sys.exit("ilk kontrol kuyruğunda yalnız --gorevli ile inceleyen değiştirilebilir")
            g["gorevli_kimlik"] = yeni_gorevli
            gorev_olay_ekle(g, a.from_, "ilk kontrol görevlisi değiştirildi", yeni_gorevli)
            return g, True, yeni_gorevli
        if durum not in ("pending", "assigned", "pending_revision"):
            sys.exit(
                f"Geçersiz geçiş: görev #{a.id} durumu '{durum}'; "
                "ata yalnız pending/assigned/pending_revision durumlarında yapılabilir")
        if not kime:
            sys.exit("bu durumdaki atama için hedef işçi kimliği (kime) gerekli")
        g["assignee"] = kime
        if yeni_gorevli:
            g["gorevli_kimlik"] = yeni_gorevli
        g["durum"] = "assigned"
        gorev_olay_ekle(g, a.from_, "atandı", a.not_)
        return g, False, yeni_gorevli

    g, yalniz_gorevli, yeni_gorevli = gorev_guncelle(_ata)
    kullanici_dokun(a.from_)
    if yalniz_gorevli:
        mesaj_ekle(a.from_, f"🧰 #{g['id']} ({g['baslik']}) ilk kontrol görevlisi @{yeni_gorevli} oldu",
                   kime=yeni_gorevli, tur="gorev")
        print(f"✅ #{g['id']} ilk kontrol görevlisi → {goster_ad(yeni_gorevli)}")
        return
    mesaj_ekle(a.from_, f"📋 #{g['id']} ({g['baslik']}) sana atandı"
               + (f" — {a.not_}" if a.not_ else ""), kime=kime, tur="gorev")
    print(f"✅ #{g['id']} → {goster_ad(kime)}")


def cmd_gorev_al(a):
    def _al(gb):
        g = gorev_bul(gb, a.id)
        if not g:
            sys.exit(f"Görev #{a.id} yok")
        durum = g.get("durum")
        if durum not in ("pending", "pending_revision"):
            sys.exit(
                f"Geçersiz geçiş: görev #{a.id} durumu '{durum}'; "
                "al yalnız pending veya pending_revision durumunda yapılabilir")
        mevcut = g.get("assignee")
        if mevcut and mevcut != a.from_:
            sys.exit(
                f"Görev #{a.id} başka bir assignee'ye ait ({mevcut}); "
                "al yapılamaz")
        if not mevcut:
            g["assignee"] = a.from_
        g["durum"] = "assigned"
        gorev_olay_ekle(g, a.from_, "Üstlenildi")
        return g

    g = gorev_guncelle(_al)
    kullanici_dokun(a.from_)
    mesaj_ekle(a.from_, f"🔨 #{g['id']} ({g['baslik']}) üstlendim, çalışıyorum",
               kime=g["kimden"], tur="not")
    print(f"✅ #{g['id']} üstlenildi")


def cmd_gorev_teslim(a):
    def _teslim(gb):
        g = gorev_bul(gb, a.id)
        if not g:
            sys.exit(f"Görev #{a.id} yok")
        durum = g.get("durum")
        if durum != "assigned":
            sys.exit(
                f"Geçersiz geçiş: görev #{a.id} durumu '{durum}'; "
                "teslim yalnız assigned durumunda yapılabilir "
                "(revize sonrası önce al)")
        assignee = g.get("assignee")
        if not assignee:
            sys.exit(
                f"Görev #{a.id} assignee boş; teslim için önce al/ata gerekli")
        if assignee != a.from_:
            sys.exit(
                f"Görev #{a.id} assignee '{assignee}'; teslim yalnız mevcut "
                "assignee tarafından yapılabilir")
        durum = durum_oku()
        goreci = durum["kullanicilar"].get(assignee, {})
        denetci = goreci.get("sorumlu_kimlik")
        if denetci and durum["kullanicilar"].get(denetci, {}).get("rol") == "denetci":
            g["inceleyen_kimlik"] = denetci
        else:
            # Eski/bağı olmayan işler tüm denetçilerin ortak kuyruğunda kalır.
            g.pop("inceleyen_kimlik", None)
        if g.get("gorevli_kimlik"):
            if durum["kullanicilar"].get(g["gorevli_kimlik"], {}).get("rol") != "goreci":
                sys.exit("kayıtlı ilk kontrol görevlisi artık görevli rolünde değil; önce --gorevli ile yeniden ata")
            g["durum"] = "pending_gorevli_review"
        else:
            g["durum"] = "pending_verification"
        gorev_olay_ekle(g, a.from_, "teslim edildi", a.not_)
        return g

    g = gorev_guncelle(_teslim)
    kullanici_dokun(a.from_)
    hedef = g.get("gorevli_kimlik") if g.get("durum") == "pending_gorevli_review" else "@hepsi"
    kuyruk = "ilk kontrol bekliyor" if g.get("durum") == "pending_gorevli_review" else "denetim bekliyor"
    mesaj_ekle(a.from_, f"📦 #{g['id']} ({g['baslik']}) teslim edildi → {kuyruk}"
               + (f" — {a.not_}" if a.not_ else ""),
               kime=hedef, tur="rapor")
    print(f"✅ #{g['id']} teslim edildi, {kuyruk}")


def gorevli_kimligi_dogrula(kimlik, durum=None):
    durum = durum or durum_oku()
    if not kimlik:
        return None, "yeni görev için --gorevli <kimlik> gerekli"
    hedef = coz_kimlik(kimlik, durum)
    if not hedef:
        return None, f"bilinmeyen görevli kimliği: {kimlik}"
    if durum["kullanicilar"].get(hedef, {}).get("rol") != "goreci":
        return None, f"ilk kontrol ataması görevli rolü gerektirir: {hedef}"
    return hedef, None


def cmd_gorev_ilk_kontrol(a):
    def _kontrol(gb):
        g = gorev_bul(gb, a.id)
        if not g:
            sys.exit(f"Görev #{a.id} yok")
        if g.get("durum") != "pending_gorevli_review":
            sys.exit(f"Geçersiz geçiş: görev #{a.id} ilk kontrol kuyruğunda değil")
        hedef = g.get("gorevli_kimlik")
        kayit = durum_oku()
        gorevli = kayit["kullanicilar"].get(a.from_, {})
        if gorevli.get("rol") != "goreci" or a.from_ != hedef:
            sys.exit(f"ilk kontrol yalnız kayıtlı görevli kimliğiyle yapılabilir: {hedef}")
        if a.onayla == a.revize:
            sys.exit("Tam olarak bir karar bayrağı gerekli: --onayla veya --revize")
        if a.onayla:
            g["durum"] = "pending_verification"
            olay = "ilk kontrol onaylandı"
        else:
            g["durum"] = "pending_revision"
            olay = "ilk kontrol revize istedi"
        gorev_olay_ekle(g, a.from_, olay, a.not_)
        return g, olay

    g, olay = gorev_guncelle(_kontrol)
    kullanici_dokun(a.from_)
    mesaj_ekle(a.from_, f"🧰 #{g['id']} ({g['baslik']}) {olay}"
               + (f" — {a.not_}" if a.not_ else ""),
               kime=g.get("assignee") or "@hepsi", tur="denetim")
    print(f"✅ #{g['id']} {olay}")


def cmd_gorev_denetle(a):
    def _denetle(gb):
        g = gorev_bul(gb, a.id)
        if not g:
            sys.exit(f"Görev #{a.id} yok")
        durum_kayit = durum_oku()
        denetci = durum_kayit["kullanicilar"].get(a.from_, {})
        if denetci.get("rol") != "denetci":
            sys.exit("denetleme yalnız denetçi rolündeki kimlik tarafından yapılabilir")
        hedef_denetcisi = g.get("inceleyen_kimlik")
        if (hedef_denetcisi and a.from_ != hedef_denetcisi
                and not denetci.get("bas_denetci")):
            sys.exit(f"görev incelemesi {hedef_denetcisi} kimliğine yönlendirilmiş")
        if a.onayla == a.revize:
            sys.exit(
                "Tam olarak bir karar bayrağı gerekli: "
                "--onayla veya --revize (ikisi birlikte olamaz)")
        durum = g.get("durum")
        if durum != "pending_verification":
            sys.exit(
                f"Geçersiz geçiş: görev #{a.id} durumu '{durum}'; "
                "denetle yalnız pending_verification durumunda yapılabilir")
        if a.onayla:
            g["durum"] = "verified"
            olay, tur, isaret = "onaylandı", "denetim", "✅"
        else:
            g["durum"] = "pending_revision"
            olay, tur, isaret = "revize istendi", "denetim", "✎"
        gorev_olay_ekle(g, a.from_, olay, a.not_)
        return g, olay, tur, isaret

    g, olay, tur, isaret = gorev_guncelle(_denetle)
    kullanici_dokun(a.from_)
    mesaj_ekle(a.from_, f"{isaret} #{g['id']} ({g['baslik']}) {olay}"
               + (f" — {a.not_}" if a.not_ else ""),
               kime=g.get("assignee") or "@hepsi", tur=tur)
    print(f"✅ #{g['id']} {olay}")


def cmd_gorev_iptal(a):
    def _iptal(gb):
        g = gorev_bul(gb, a.id)
        if not g:
            sys.exit(f"Görev #{a.id} yok")
        durum = g.get("durum")
        if durum in ("verified", "dropped"):
            sys.exit(
                f"Geçersiz geçiş: görev #{a.id} durumu '{durum}'; "
                "iptal terminal görevi değiştiremez")
        g["durum"] = "dropped"
        gorev_olay_ekle(g, a.from_, "iptal edildi", a.not_)
        return g

    g = gorev_guncelle(_iptal)
    kullanici_dokun(a.from_)
    print(f"✅ #{g['id']} iptal")


def cmd_gorev_liste(a):
    cmd_tahta(a)


def cmd_protokol(bos):
    print((CODE_ROOT / "protokol.md").read_text(encoding="utf-8"))


def cmd_panel(a):
    os.execv(sys.executable, [sys.executable,
                              str(CODE_ROOT / "panel" / "server.py"),
                              "--port", str(a.port)])


# ── ayrıştırıcı ───────────────────────────────────────────────────────

class P(argparse.ArgumentParser):
    """argparse varsayılan 'required subcommand' davranışını korur."""


def main():
    p = P(prog="yuva", description="🪹 model yuvası")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("baglan", help="panele bağlan (yeşil ışık + kalp)")
    s.add_argument("kimlik")
    s.add_argument("--ad", help="görünen ad (örn. sam)")
    s.add_argument("--arac", default="diger", choices=list(ARACLAR))
    s.add_argument("--rol", default="isci", choices=list(ROLLER))
    s.add_argument("--panel")
    s.add_argument("--kalp", dest="kalp", action="store_true", default=True)
    s.add_argument("--kalp-yok", dest="kalp", action="store_false")
    s.add_argument("--kalp-sn", type=kalp_araligi, default=10,
                   help=f"heartbeat aralığı (1-{KALP_ARALIK_UST} sn; varsayılan 10)")
    s.add_argument("--kalp-ttl", type=int, default=0,
                   help="kalp daemon'ının azami ömrü (sn), 0=sınırsız (varsayılan)")
    s.set_defaults(fn=cmd_baglan)

    s = sub.add_parser("katil", help="yuvaya katıl (=baglan)")
    s.add_argument("ad")
    s.add_argument("--arac", default="diger", choices=list(ARACLAR))
    s.add_argument("--rol", default="isci", choices=list(ROLLER))
    s.add_argument("--panel")
    s.add_argument("--kalp", dest="kalp", action="store_true", default=True)
    s.add_argument("--kalp-yok", dest="kalp", action="store_false")
    s.add_argument("--kalp-sn", type=kalp_araligi, default=10,
                   help=f"heartbeat aralığı (1-{KALP_ARALIK_UST} sn; varsayılan 10)")
    s.add_argument("--kalp-ttl", type=int, default=0,
                   help="kalp daemon'ının azami ömrü (sn), 0=sınırsız (varsayılan)")
    s.set_defaults(fn=cmd_katil)

    s = sub.add_parser("kalp", help="tek seferlik kalp atışı")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_kalp)

    s = sub.add_parser("kalp-dongu", help="arka plan kalp döngüsü (daemon)")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--pid", type=int, default=0,
                   help="ebeveyn süreç kimliği (sahiplik anahtarı değildir)")
    s.add_argument("--ata-baslangic", type=int, default=0)
    s.add_argument("--kilit-fd", type=int,
                   help="daemon sahipliği için devralınan flock dosya tanıtıcısı")
    s.add_argument("--hazirlik-fd", type=int,
                   help="başlangıç readiness sonucunu başlatıcıya ileten FD")
    s.add_argument("--sn", type=kalp_araligi, default=10)
    s.add_argument("--ttl", type=int, default=0,
                   help="azami ömür (sn), 0=sınırsız (varsayılan)")
    s.add_argument("--panel")
    s.add_argument("--host-supervised", action="store_true")
    s.add_argument("--host-token")
    s.add_argument("--host-instance")
    s.set_defaults(fn=cmd_kalp_dongu)

    s = sub.add_parser("ayril", help="yuvadan ayrıl (ışık söner)")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_ayril)

    s = sub.add_parser("ad", help="görünen ad ver/değiştir")
    s.add_argument("yeni")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_ad)

    s = sub.add_parser("ekran", help="model ekranına satır yaz / oku")
    s.add_argument("satir", nargs="*")
    s.add_argument("--from", dest="from_")
    s.add_argument("--tur", default="ekran",
                   choices=["ekran", "komut", "sonuc", "baslik"])
    s.add_argument("--n", type=int, default=30)
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_ekran)

    s = sub.add_parser("durum", help="kimlik kartın: ad, rol, ışık, sayaçlar")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_durum)

    s = sub.add_parser("kimler", help="kim var")
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_kimler)

    s = sub.add_parser("sorumlu", help="kimlik için denetçi ekip bağını ata/kaldır")
    s.add_argument("kimlik")
    sec = s.add_mutually_exclusive_group(required=True)
    sec.add_argument("--ata", dest="denetci", help="denetçi kimliği")
    sec.add_argument("--kaldir", action="store_true", help="mevcut bağı kaldır")
    s.set_defaults(fn=cmd_sorumlu)

    s = sub.add_parser("bas-denetci", help="baş denetçiyi ata/kaldır")
    s.add_argument("kimlik", nargs="?")
    s.add_argument("--kaldir", action="store_true")
    s.set_defaults(fn=cmd_bas_denetci)

    s = sub.add_parser("yaz", help="yuvaya mesaj yaz")
    s.add_argument("metin")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--to", default="@hepsi")
    s.add_argument("--tur", default="not",
                   choices=["not", "soru", "cevap", "rapor", "denetim", "gorev", "durum"])
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_yaz)

    s = sub.add_parser("oku", help="son mesajları oku")
    s.add_argument("--n", type=int, default=20)
    s.add_argument("--from", dest="from_")
    s.add_argument("--user")
    s.set_defaults(fn=cmd_oku)

    s = sub.add_parser("gelen", help="gelen kutun + görevlerin")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--panel")
    s.set_defaults(fn=cmd_gelen)

    s = sub.add_parser("tahta", help="görev tahtası")
    s.set_defaults(fn=cmd_tahta)

    sg = sub.add_parser("gorev", help="görev işlemleri")
    gsub = sg.add_subparsers(dest="gop", required=True)

    s = gsub.add_parser("ekle")
    s.add_argument("baslik")
    s.add_argument("--detay")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--ata")
    s.add_argument("--gorevli", required=True, help="ilk kontrolü yapacak görevli kimliği")
    s.add_argument("--ust-gorev", dest="ust_gorev_id", type=gorev_id_arg,
                   help="var olan üst görevin IDsi; verilmezse yeni görev köktür")
    s.set_defaults(fn=cmd_gorev_ekle)

    for ad_, fn_, ekstra in [
        ("ata", cmd_gorev_ata, []),
        ("al", cmd_gorev_al, []),
        ("teslim", cmd_gorev_teslim, []),
        ("ilk-kontrol", cmd_gorev_ilk_kontrol, []),
        ("denetle", cmd_gorev_denetle, []),
        ("iptal", cmd_gorev_iptal, []),
    ]:
        s = gsub.add_parser(ad_)
        s.add_argument("id")
        s.add_argument("--from", dest="from_", required=True)
        s.add_argument("--not", dest="not_")
        if ekstra:
            s.add_argument(ekstra[0])
        if ad_ == "ata":
            s.add_argument("kime", nargs="?")
            s.add_argument("--gorevli", help="ilk kontrol görevli ataması/değişikliği")
        if ad_ == "denetle":
            s.add_argument("--onayla", action="store_true")
            s.add_argument("--revize", action="store_true")
        if ad_ == "ilk-kontrol":
            s.add_argument("--onayla", action="store_true")
            s.add_argument("--revize", action="store_true")
        s.set_defaults(fn=fn_)

    s = sub.add_parser("liste", help="= tahta")
    s.set_defaults(fn=cmd_gorev_liste)

    sub.add_parser("protokol", help="protokolü göster").set_defaults(fn=cmd_protokol)

    s = sub.add_parser("panel", help="web panelini başlat")
    s.add_argument("--port", type=int, default=8686)
    s.set_defaults(fn=cmd_panel)

    a = p.parse_args()
    # This UI development snapshot is not pinned to the canonical data writer.
    # Reject task mutations before identity resolution or any data access.
    if (getattr(a, "cmd", None) == "gorev"
            and getattr(a, "gop", None) in {
                "ekle", "ata", "al", "sonraki", "teslim", "ilk-kontrol",
                "denetle", "iptal",
            }):
        print("❌ görev yazımı reddedildi: kanonik writer kullanın", file=sys.stderr)
        sys.exit(2)
    # kimlik/ad çözümleme: --from/--to/--ata/--kime hem kimlik hem görünen ad kabul eder
    try:
        for alan in ("from_", "to", "ata", "gorevli", "kime", "user"):
            deger = getattr(a, alan, None)
            if isinstance(deger, str) and deger:
                k = coz_kimlik(deger)
                if k:
                    setattr(a, alan, k)
        a.fn(a)
        # Kalp daemon'ı ölmüşse yaygın komutlardan sonra da güvenli biçimde onar.
        # ayril/baglan/kalp-dongu kendi akışını yönetir; onlarda otomatik başlatma yok.
        if (getattr(a, "from_", None)
                and getattr(a, "cmd", None) not in
                ("baglan", "katil", "ayril", "kalp", "kalp-dongu")):
            try:
                kalp_guven(a.from_, getattr(a, "panel", None))
            except Exception as e:
                saglik_guncelle(a.from_, "hata", f"kalp_guven: {e}")
    except VeriHatasi as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(2)
    except OSError as e:
        print(f"❌ dosya işlemi başarısız: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
