    s = sub.add_parser("doctor", help="kurulum önkoşullarını salt okunur denetle")
    s.add_argument("--install-root", type=Path,
                   default=Path.home() / ".local" / "opt" / "yuva")
    s.add_argument("--port", type=int, default=8686)
    s.set_defaults(fn=cmd_doctor)

    sa = sub.add_parser("auth", help="offline auth store hazırlama işlemleri")
    auth_sub = sa.add_subparsers(dest="auth_cmd", required=True)
    s = auth_sub.add_parser("init", help="boş auth-state v2 store ve sabit lock oluştur")
    s.add_argument("--store-root", type=Path, required=True,
                   help="önceden var olan, euid sahipliğinde 0700 mutlak dizin")
    s.add_argument("--instance-id", required=True,
                   help="bu Yuva instance'ı için kararlı ID")
    s.add_argument("--audience", required=True,
                   help="bu store için exact API audience")
    s.set_defaults(fn=cmd_auth_init)

    s = auth_sub.add_parser(
        "provision", help="yalnız geçici store için idempotent empty-store provision fixture")
    s.add_argument("--store-root", type=Path, required=True,
                   help="önceden var olan TemporaryDirectory altında euid sahipli 0700 dizin")
    s.add_argument("--instance-id", required=True)
    s.add_argument("--audience", required=True)
    s.add_argument("--operation-id", required=True,
                   help="secret içermeyen ve retry boyunca sabit operasyon kimliği")
    s.set_defaults(fn=cmd_auth_provision)

    a = p.parse_args()
    # kimlik/ad çözümleme: --from/--to/--ata/--kime hem kimlik hem görünen ad kabul eder
    try:
        for alan in ("from_", "to", "ata", "gorevli", "kime", "user"):
            if a.cmd == "wait" and alan == "from_":
                continue  # wait accepts an exact roster key, never a fuzzy display name
            deger = getattr(a, alan, None)
            if isinstance(deger, str) and deger:
                k = coz_kimlik(deger)
                if k:
                    setattr(a, alan, k)
        result = a.fn(a)
        if a.cmd == "wait":
            raise SystemExit(result)
    except VeriHatasi as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(2)
    except OSError as e:
        number = e.errno if type(e.errno) is int and 0 <= e.errno <= 999 else "-"
        print(f"❌ dosya işlemi başarısız (errno={number})", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
