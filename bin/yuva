    s = sub.add_parser("panel", help="web panelini başlat")
    s.add_argument("action", nargs="?", choices=("start", "status", "stop"),
                   help="doğrulanmış yuva-panel.service için start/status/stop")
    s.add_argument("--port", type=int, default=8686)
