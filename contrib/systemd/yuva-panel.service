[Unit]
Description=Yuva panel UI and API (persistent user service)

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/yuva/current
Environment=YUVA_DIR=%h/yuva
ExecStart=/usr/bin/python3 -u %h/.local/opt/yuva/current/panel/server.py --host 127.0.0.1 --port 8686
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
